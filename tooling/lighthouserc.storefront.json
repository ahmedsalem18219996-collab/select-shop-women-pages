{
  "ci": {
    "collect": {
      "startServerCommand": "node serve.mjs",
      "startServerReadyPattern": "QA server",
      "url": [
        "http://127.0.0.1:4173/",
        "http://127.0.0.1:4173/p/?code=SS-1008"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices"],
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.90, "aggregationMethod": "median-run"}],
        "largest-contentful-paint": ["warn", {"maxNumericValue": 2500, "aggregationMethod": "median-run"}],
        "cumulative-layout-shift": ["warn", {"maxNumericValue": 0.1, "aggregationMethod": "median-run"}]
      }
    },
    "upload": {"target": "filesystem", "outputDir": ".lighthouseci/storefront"}
  }
}